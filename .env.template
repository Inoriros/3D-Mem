# Environment variables template for 3D-Mem project
# Copy this file to .env and fill in your actual values

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENDPOINT=https://api.openai.com/v1

# Ollama Configuration  
USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:72b

# Example for H200 setup:
# OLLAMA_URL=http://your_h200_ip:11434
# OLLAMA_MODEL=qwen2.5vl:72b

# Instructions:
# 1. Copy this file: cp .env.template .env
# 2. Edit .env with your actual API keys and configuration
# 3. Never commit the .env file to git (it's in .gitignore)
